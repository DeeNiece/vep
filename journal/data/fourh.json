":68.4,"tp_pips":171.0,"rr":2.5,"stale_pips":-0.0,"flag":"","prior24_x":1.26,"context":"with the prior 24h move","mv_intraday":35.6,"mfe_intraday":53.5,"mae_intraday":3.8,"A_intraday":{"res":"open","R":0.52,"h":12.9},"C0.5_intraday":{"res":"TP","R":2.0,"h":4.5},"C0.75_intraday":{"res":"TP","R":2.0,"h":4.6},"C1.0_intraday":{"res":"open","R":1.09,"h":12.9},"mv_24h":null,"mfe_24h":null,"mae_24h":null,"A_24h":{"res":"open","R":1.06,"h":19.8},"C0.5_24h":{"res":"TP","R":2.0,"h":4.5},"C0.75_24h":{"res":"TP","R":2.0,"h":4.6},"C1.0_24h":{"res":"TP","R":2.0,"h":13.8},"mv_48h":null,"mfe_48h":null,"mae_48h":null,"A_48h":{"res":"open","R":1.06,"h":19.8},"C0.5_48h":{"res":"TP","R":2.0,"h":4.5},"C0.75_48h":{"res":"TP","R":2.0,"h":4.6},"C1.0_48h":{"res":"TP","R":2.0,"h":13.8}}],"coverage":[{"sym":"XAUUSD","has_4h":false,"alerts":0,"last":"","note":"M30 alert only. 4H read comes from the chart."},{"sym":"XAGUSD","has_4h":false,"alerts":0,"last":"","note":"M30 alert only. 4H read comes from the chart."},{"sym":"USDJPY","has_4h":true,"alerts":4,"last":"2026-11-10 10:00","note":""},{"sym":"AUDJPY","has_4h":true,"alerts":3,"last":"2026-11-13 10:00","note":""},{"sym":"CADJPY","has_4h":true,"alerts":2,"last":"2026-11-09 22:00","note":""},{"sym":"GBPJPY","has_4h":true,"alerts":2,"last":"2026-11-09 22:00","note":""},{"sym":"EURUSD","has_4h":false,"alerts":0,"last":"","note":"M30 alert only. 4H read comes from the chart."},{"sym":"GBPUSD","has_4h":true,"alerts":4,"last":"2026-11-12 18:00","note":""},{"sym":"AUDUSD","has_4h":true,"alerts":3,"last":"2026-11-11 10:00","note":""},{"sym":"USDCAD","has_4h":true,"alerts":1,"last":"2026-11-09 10:00","note":""},{"sym":"USDCHF","has_4h":true,"alerts":3,"last":"2026-11-10 14:00","note":"Dropped from the watchlist. Delete this alert."}],"m30_alerts_same_log":327,"findings":[{"tag":"Fact","title":"Only 8 of the 11 symbols have a 4H alert","body":"GBPUSD, AUDUSD, USDJPY, AUDJPY, CADJPY, GBPJPY, USDCAD and USDCHF have one. EURUSD, XAUUSD and XAGUSD run an M30 alert only, so their 4H labels are read from the chart and are not in this table. In the same log window the M30 alerts fired 327 times against 22 for 4H, so 4H alerts are rare."},{"tag":"Fact","title":"The alerts' own Entry, PTP and PSL are not reliable, so ignore them","body":"4 of 22 are malformed (stop on the wrong side of entry, or a stop under 5 pips). 7 of 22 had price already more than 10 pips past the Entry when the alert fired, so that entry could not be filled. Stop size ranged from 0.02 to 5.5 times a typical 4H candle (median 0.8). The target is always about 2.5 times the stop, so it does not look at the market. The default view uses a uniform rule instead, and the \"Alert numbers\" view is there for comparison."},{"tag":"Early read","title":"Direction was right about two times in three","body":"14 of 21 alerts were in profit 24 hours later (67%). With only 21 alerts the 95% range is 45% to 83%, so this is better than a coin flip but not proven. After 48 hours it was 12 of 20 (60%)."},{"tag":"Early read","title":"Alerts that agree with the prior 24h move did much better than alerts that fight it","body":"11 alerts agreed with the move of the prior 24 hours. Under the uniform rule (stop 0.75 times a 4H candle, target 2R, 24h) they won 7 of 11 for +10R. The 11 that fought the prior move won 2 of 11 for -5R, even though price ended in their direction 7 times out of 11. They were right too late: price went against them first. A 4H reversal alert is not a place to enter."},{"tag":"Early read","title":"Right direction, wrong timing: price usually goes against you before it goes for you","body":"In the 24h after an alert, the average best move was 37 pips and the average worst move was 34 pips. The clearest case is USDJPY: all three buy alerts from Mon 18:00 to Tue 02:00 HK ended 24h higher, and 48h later price was 92 to 180 pips higher. All three still hit a 0.75-candle stop first. This backs your 4H-first rule: use the 4H alert for direction, and enter on M30."},{"tag":"Early read","title":"Tiers: no tier is proven, and the sample is tiny","body":"T1 (6 alerts) was right at 24h 4 times and broke even on its own numbers. T2 (6 alerts) was right 4 of 5 at 24h and 5 of 5 at 48h, but its own stops were hit 3 times out of 5. T3 (10 alerts) was right 6 of 10 at 24h but only 3 of 10 at 48h, which suggests T3 moves fade after a day. Differences this size are inside the noise."},{"tag":"Warning","title":"13 of the 22 alerts came on one day","body":"Mon 9 Nov holds 13 alerts, mostly USD pairs moving together, and the 3 USDJPY buys overlap in time. The real number of independent trades is lower than 22. Look at this table again after 40 or more alerts before changing any rule."},{"tag":"Rule to test","title":"Treat the 4H alert as a direction filter and skip the ones that fight the prior 24h move","body":"Rule: take M30 entries only in the direction of a 4H alert from the last 24 hours, and ignore 4H alerts that point against the prior 24h move unless a 4H candle confirms. This comes from 21 alerts, so it is a guess. Test it for two weeks."}]}